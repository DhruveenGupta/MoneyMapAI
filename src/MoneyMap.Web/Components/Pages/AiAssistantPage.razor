@page "/assistant"
@rendermode InteractiveServer
@inject BudgetProfileService ProfileService
@inject AiAssistantCoordinator Assistant
@inject IClock Clock

<PageTitle>MoneyMap AI - Assistant</PageTitle>

<h1>AI Assistant</h1>
<div class="mm-banner mm-banner-info" role="note">
    <span aria-hidden="true">ℹ</span>
    <div>
        @if (Assistant.RemoteProviderConfigured)
        {
            <span>Answers are generated by a remote AI model using only your budget's totals, plus MoneyMap's own calculations.</span>
        }
        else
        {
            <span>No remote AI provider is configured, so you're talking to MoneyMap's built-in assistant. It works fully offline and still uses your real numbers.</span>
        }
        This is educational information, not personalized financial advice.
    </div>
</div>

<div class="mm-card">
    <div class="mm-chat-log" aria-live="polite">
        @if (_history.Count == 0)
        {
            <p class="mm-text-sm" style="color:var(--mm-text-muted);">Try asking: "Explain my budget", "Am I over budget anywhere?", "Can I afford $50?", or "What is compound interest?"</p>
        }
        @foreach (var (turn, reply) in _history)
        {
            <div class="mm-chat-bubble mm-chat-bubble-user">@turn.Content</div>
            @if (reply is not null)
            {
                <div>
                    <div class="mm-chat-bubble mm-chat-bubble-assistant">
                        @reply.Message
                    </div>
                    <div class="mm-chat-meta">
                        @reply.ProviderName
                        @if (reply.IsFallback)
                        {
                            <span> · @reply.LimitationNotice</span>
                        }
                    </div>
                    @if (reply.ProposedChanges.Count > 0)
                    {
                        @foreach (var change in reply.ProposedChanges)
                        {
                            <div class="mm-banner mm-banner-warning" style="margin-top:8px;">
                                <span aria-hidden="true">💡</span>
                                <div>
                                    <strong>Suggested change:</strong> @ExpenseCategoryInfo.DisplayName(change.Category) @(change.DeltaAmount < 0 ? "decrease" : "increase") of @FormatMoney(Math.Abs(change.DeltaAmount)).
                                    <div class="mm-text-sm">@change.Rationale</div>
                                    <div style="margin-top:6px;">
                                        <button class="mm-btn mm-btn-primary mm-btn-sm" @onclick="() => ApplyChange(change)">Apply this change</button>
                                        <span class="mm-text-sm" style="margin-left:8px; color:var(--mm-text-muted);">Nothing changes until you click Apply.</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        }
        @if (_sending)
        {
            <div class="mm-chat-bubble mm-chat-bubble-assistant" aria-live="polite">Thinking…</div>
        }
    </div>

    <form @onsubmit="SendMessage" @onsubmit:preventDefault="true" style="display:flex; gap:8px; margin-top:12px;">
        <label for="chat-input" class="mm-visually-hidden">Your message</label>
        <input id="chat-input" class="mm-input" style="flex:1;" @bind="_draft" @bind:event="oninput" placeholder="Ask about your budget…" />
        <button class="mm-btn mm-btn-primary" type="submit" disabled="@(_sending || string.IsNullOrWhiteSpace(_draft))">Send</button>
    </form>
    @if (_appliedMessage is not null)
    {
        <p class="mm-text-sm" role="status" style="color:var(--mm-success-700); margin-top:8px;">@_appliedMessage</p>
    }
</div>

@code {
    private readonly List<(ChatTurn Turn, AiAssistantReply? Reply)> _history = new();
    private string _draft = string.Empty;
    private bool _sending;
    private string? _appliedMessage;

    private async Task SendMessage()
    {
        var message = _draft.Trim();
        if (string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        _draft = string.Empty;
        _sending = true;
        _appliedMessage = null;
        var userTurn = new ChatTurn(ChatRole.User, message);
        _history.Add((userTurn, null));
        StateHasChanged();

        var profile = await ProfileService.GetProfileAsync();
        var summary = await ProfileService.GetSummaryAsync();
        var context = AiFinancialContext.Build(summary, profile.SavingsGoals, Clock.Today);

        var historyForRequest = _history
            .Where(h => h.Reply is not null)
            .SelectMany(h => new[] { h.Turn, new ChatTurn(ChatRole.Assistant, h.Reply!.Message) })
            .ToList();

        var reply = await Assistant.AskAsync(new AiAssistantRequest
        {
            UserMessage = message,
            Context = context,
            History = historyForRequest,
        });

        _history[^1] = (userTurn, reply);
        _sending = false;
    }

    private async Task ApplyChange(ProposedBudgetChange change)
    {
        await ProfileService.ApplyProposedChangeAsync(change);
        _appliedMessage = $"Applied: {ExpenseCategoryInfo.DisplayName(change.Category)} adjusted by {FormatMoney(change.DeltaAmount)}.";
    }

    private string FormatMoney(decimal amount) => _cachedCurrency is null ? amount.ToString("0.00") : new Money(amount, _cachedCurrency).ToString();

    private string? _cachedCurrency;

    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileService.GetProfileAsync();
        _cachedCurrency = profile.Budget.Currency;
    }
}
