<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MoneyMap.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    <script>
        // Applied synchronously, before first paint, to avoid a flash of the wrong theme/text size.
        (function () {
            try {
                var theme = localStorage.getItem('moneymap-theme');
                if (theme === 'light' || theme === 'dark') {
                    document.documentElement.setAttribute('data-theme', theme);
                }
                var scale = localStorage.getItem('moneymap-text-scale');
                if (scale) {
                    document.documentElement.style.setProperty('--mm-text-scale', scale);
                }
            } catch (e) { /* localStorage unavailable (private mode, etc.) - safe to ignore */ }
        })();
    </script>
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/preferences.js"]"></script>
</body>

</html>
