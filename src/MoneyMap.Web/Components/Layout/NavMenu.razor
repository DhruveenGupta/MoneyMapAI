<a href="/" class="mm-brand" @onclick="NotifyNavigate">
    <span class="mm-brand-mark" aria-hidden="true">M</span>
    MoneyMap AI
</a>

<ul id="mm-primary-nav" style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:4px;">
    @foreach (var item in _items)
    {
        <li>
            <NavLink class="mm-nav-link" href="@item.Href" Match="@item.Match" @onclick="NotifyNavigate">
                <span aria-hidden="true">@item.Icon</span>
                <span>@item.Label</span>
            </NavLink>
        </li>
    }
</ul>

<div style="margin-top:auto; padding-top:16px; font-size:0.78rem; color:#b9d4d1;">
    MoneyMap AI is an educational tool, not financial, tax, or investment advice.
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    private Task NotifyNavigate() => OnNavigate.InvokeAsync();

    private sealed record NavItem(string Href, string Label, string Icon, NavLinkMatch Match);

    private readonly NavItem[] _items =
    [
        new("/", "Home", "🏠", NavLinkMatch.All),
        new("/onboarding", "Onboarding", "📝", NavLinkMatch.Prefix),
        new("/dashboard", "Dashboard", "📊", NavLinkMatch.Prefix),
        new("/budget", "Budget Builder", "🧮", NavLinkMatch.Prefix),
        new("/goals", "Savings Goals", "🎯", NavLinkMatch.Prefix),
        new("/invest", "Investment Simulator", "📈", NavLinkMatch.Prefix),
        new("/assistant", "AI Assistant", "💬", NavLinkMatch.Prefix),
        new("/privacy", "Privacy & Data", "🔒", NavLinkMatch.Prefix),
    ];
}
